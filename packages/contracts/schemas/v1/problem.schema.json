{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://geoempleo.example/contracts/v1/problem.schema.json",
  "type": "object",
  "properties": {
    "contractVersion": {
      "const": "1.0.0"
    },
    "code": {
      "type": "string",
      "enum": [
        "invalid_request",
        "not_found",
        "unavailable"
      ]
    },
    "message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "\\S"
    },
    "requestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "\\S"
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "maxLength": 512
          },
          "code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "\\S"
          }
        },
        "required": [
          "path",
          "code"
        ],
        "additionalProperties": false
      },
      "maxItems": 20
    }
  },
  "required": [
    "contractVersion",
    "code",
    "message",
    "requestId",
    "issues"
  ],
  "additionalProperties": false
}
