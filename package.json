{
  "name": "geoempleo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev:web": "node apps/web-preview/server.mjs",
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check": "npm run typecheck && npm test && npm run check:openapi && npm run test:contracts:python",
    "generate:openapi": "node packages/contracts/tools/generate-openapi.ts",
    "check:openapi": "node packages/contracts/tools/generate-openapi.ts --check",
    "test:contracts:python": "node packages/contracts/tools/check-python.mjs",
    "ingest:daily": "node packages/ingestion/src/cli.ts",
    "report:coverage": "node packages/ingestion/src/coverage-cli.ts",
    "audit:aragon": "node packages/ingestion/src/aragon-audit-cli.ts",
    "build:web:static": "node tools/build-static-site.mjs"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "parse5": "8.0.0"
  }
}
