{
  "name": "geoempleo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check": "npm run typecheck && npm test && npm run check:openapi && npm run test:contracts:python",
    "generate:openapi": "node packages/contracts/tools/generate-openapi.ts",
    "check:openapi": "node packages/contracts/tools/generate-openapi.ts --check",
    "test:contracts:python": "node packages/contracts/tools/check-python.mjs"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "ajv": "8.20.0"
  }
}
